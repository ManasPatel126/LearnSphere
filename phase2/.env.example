# Phase 2 — Required environment variables
# Copy to .env and fill in your keys

# ── Core ──────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Gemini (quality scoring) ──────────────────
GEMINI_API_KEY=your_gemini_api_key_here

# ── YouTube Data API v3 (search only) ─────────
# Get from: https://console.cloud.google.com → APIs → YouTube Data API v3
YOUTUBE_API_KEY=your_youtube_api_key_here

# ── GitHub (unauthenticated = 60 req/hr, token = 5000 req/hr) ──
# Create at: https://github.com/settings/tokens (read-only, no scopes needed)
GITHUB_TOKEN=your_github_token_here

# ── Reddit (read-only app) ────────────────────
# Create at: https://www.reddit.com/prefs/apps → script app
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret
REDDIT_USER_AGENT=LearnPathBot/1.0 by YourUsername

# ── Perplexity (article fetching) ─────────────
PERPLEXITY_API_KEY=your_perplexity_api_key_here

# ── NewsAPI (fallback articles) ───────────────
# Free tier at: https://newsapi.org
NEWS_API_KEY=your_newsapi_key_here
