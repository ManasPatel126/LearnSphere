# ── Required ──────────────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379

# ── Flask ─────────────────────────────────────────────────────────────────────
FLASK_ENV=development
FLASK_DEBUG=1
FRONTEND_URL=http://localhost:5173

# ── File uploads ──────────────────────────────────────────────────────────────
UPLOAD_DIR=/tmp/phase1_uploads

# ── Phase 2 handoff (not used in Phase 1, but document it here) ───────────────
# PHASE2_TRIGGER_URL=http://localhost:5001/api/research/start
